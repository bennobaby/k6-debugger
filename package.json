{
  "name": "k6-debugger",
  "version": "0.1.2",
  "description": "Run k6 scripts under Node.js with native VSCode breakpoints, request timeline, execution tracing, deterministic replay, and runtime parity checks — no k6 binary required.",
  "type": "module",
  "bin": {
    "k6-debugger": "bin/k6-debugger.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noCheck",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test",
    "presmoke": "npm run build",
    "smoke": "node bin/k6-debugger.mjs run examples/smoke.js",
    "lint": "echo \"(no linter configured yet)\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "k6",
    "load-testing",
    "performance-testing",
    "debugger",
    "vscode",
    "tracing",
    "observability",
    "replay",
    "esm-loader"
  ],
  "author": "Benno Baby <001bennobaby@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennobaby/k6-debugger.git"
  },
  "bugs": {
    "url": "https://github.com/bennobaby/k6-debugger/issues"
  },
  "homepage": "https://github.com/bennobaby/k6-debugger#readme"
}
